# ===== 环境变量模板 =====
# 使用方法：复制本文件为 .env（同一目录），再填入真实值。
# 复制命令（PowerShell）：Copy-Item .env.example .env
# 代码通过 utils/env_utils.py 的 load_dotenv(override=True) 读取本文件。
# 注意：.env 含密钥，切勿提交到版本库（已写入 .gitignore）。

# ---- 必需 ----
# OpenAI 兼容接口的 API Key。
# llm_models/all_llm.py 在【模块顶层】构造 ChatOpenAI，缺少此变量会导致
# 几乎所有模块 import 即失败。
# 注：嵌入已改为**纯本地**模型（见下方 EMBEDDING_MODEL），不再需要远程 embedding key。
OPENAI_API_KEY=

# ---- Web 搜索（graph2 的 web_search 节点依赖）----
# 注意：这是原项目就遗漏的变量。旧版代码从未读取过它，
# TavilySearchResults 在调用时才会去读 TAVILY_API_KEY，缺失时仅 web_search 分支失败。
TAVILY_API_KEY=

# ---- 可选：备用 LLM（all_llm.py 中已注释掉的 DeepSeek 配置，取消注释后生效）----
DEEPSEEK_API_KEY=

# ===== 向量库 =====
# 本机 Milvus 服务地址。用 Milvus Lite（嵌入式）时不要写在这里 ——
# MILVUS_URI 是 pymilvus 的保留变量，它在 import 阶段就解析且只接受 http(s):// 形式。
MILVUS_URI=http://127.0.0.1:19530

# 混合检索 reranker 写法：function（官方新写法，需服务端 Milvus 2.6+）
#                        legacy（旧写法 ranker_type，已 deprecated，兼容 Lite 与旧版服务端）
# 实测 Milvus Lite 3.2.1 只支持 legacy，对 function 报
#      MilvusException code=6 Unsupported Hybrid FunctionScore reranker
MILVUS_RERANKER_STYLE=function

# ---- 多租户（ROADMAP 3.3，可选）--------------------------------------------
# 租户 -> 允许访问的源名列表（源名见 utils/env_utils.py 的 DOC_SOURCES：
# milvus_docs / papers / manuals / notes）。
#
# 采用「集合级隔离」：不同源本就写在不同集合里，租户只是在这条既有边界上
# 做子集映射 —— 因此**零 schema 改动、无需重建集合**。
#
# 未设置该变量时为单租户模式（可访问全部启用源），行为与引入多租户前一致。
#
# 用法：HTTP 请求带 `X-Tenant-Id` 头；配了多租户但未带头返回 400、未知租户 403。
#
# 若将来需要「同一集合内多租户」（如两个部门共用 milvus_docs 集合），
# 则必须给 schema 加 tenant 字段并重建集合 —— 那才是另一条路线。
# KB_TENANTS={"acme": ["milvus_docs", "manuals"], "beta": ["papers"]}

# ===== 企业级检索与多轮记忆（ROADMAP 4.42 ~ 4.45）=========================
# 以下变量全部有默认值，**不配也能跑**；配了才启用对应能力。
# 影响面说明：只有「显式传 session_id 的请求」才走记忆路径，
# 评测 / 回归 / 单轮 CLI 都不传 -> 对既有指标零影响。

# ---- reranker 精排（tools/reranker_tools.py）----
# 0=关闭（默认）：与改造前行为完全一致
# 1=开启：先用 CrossEncoder 精排收敛，再把高分块送 LLM 判分（省 token）
# 质量基线见 eval/measure_rerank_gain.py：本项目天花板只剩 9%，故默认关
RERANK_ENABLED=0
RERANK_TOP_K=20                  # 精排后保留几块
RERANK_SCORE_THRESHOLD=0         # reranker 分数门槛；0=不过滤。>0 时低于阈值的块不送判分
RERANK_MODEL=                     # 空=用项目内 models/bge-reranker-v2-m3（本地，不走网络）
RERANK_MAX_CHARS=2000            # 单块送去打分的截断长度

# ---- 聚合类深检索（tools/retriever_tools.py）----
# 问句命中「最低/最高/平均/对比…」等特征时，每集合多召回，由 reranker 收敛
PER_COLLECTION_K_DEEP=20
FINAL_K_DEEP=60

# ---- 多轮记忆（graph2/generate_node2.py）----
MAX_HISTORY_TURNS=13             # 注入 prompt 的最近轮数
MAX_HISTORY_CHARS=6000           # 历史**总预算**：超出从最老的丢起，保住最近
MAX_PER_MSG_CHARS=500            # 单条上限（防御性，已不是主约束）

# ---- 会话历史向量检索（tools/history_store.py）----
# 1=开启（默认）：找回「含具体数值的早期轮次」，三层记忆里唯一能做到的一层
HISTORY_ENABLED=1
HISTORY_COLLECTION=kb_session_history_bge_large_1024
HISTORY_TOP_K=3                  # 每次召回几轮
HISTORY_MAX_CHARS=1500           # 单轮 text 上限（表 schema VARCHAR 6000，留余量）
HISTORY_KEEP_MONTHS=3            # 历史保留月数（按月桶 TTL，purge_expired 用）

# ---- 会话管理与滑动 TTL（utils/session_store.py）----
SESSION_TTL_SECONDS=21600        # 6 小时**不活跃**才清（滑动，非创建时间）
SESSION_JANITOR_INTERVAL=1800    # 后台清理线程轮询间隔（30 分钟，远小于 TTL）

# ===== 嵌入模型（配置化：升维 / 换模型 / A/B 对照都只改这里）=====
# 默认：项目内的 bge-large-zh-v1.5（1024 维，离线可用）。
# 模型文件不随 git 走，换机后用 scripts/fetch_models.py 重建。
#
# 做 512 维 A/B 对照时取消下面三行的注释（小模型保留不删，否则失去对照能力）：
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIM=512
# KB_COLLECTION_MD=kb_milvus_bge-small_512
#
# 也可直接指定别的本地模型目录或 HF repo id：
# EMBEDDING_MODEL=D:\models\some-other-model
# EMBEDDING_DIM=768

# ===== 集合命名（规范：kb_{domain}_bge-large_{dim}）=====
# 一源一集合：不同语义域写入不同集合，避免内容相互干扰。
# 下面四项不设时用代码内默认值（即注释里的值）。
# KB_COLLECTION_MD=kb_milvus_bge_large_1024
# KB_COLLECTION_PDF=kb_papers_bge_large_1024
# KB_COLLECTION_OFFICE=kb_manuals_bge_large_1024
# KB_COLLECTION_TXT=kb_notes_bge_large_1024
#
# COLLECTION_NAME 是「默认集合」，供不按源清单运行的旧脚本使用。
# COLLECTION_NAME=kb_milvus_bge_large_1024

# ===== 路径（可选）=====
# 语料根目录（默认取包内 RAG_PROJECT/datas）
# DATAS_DIR=D:\path\to\datas
# 各源目录（默认取 DATAS_DIR 下的 md / pdf / office / txt）
# SRC_DIR_MD=
# SRC_DIR_PDF=
# SRC_DIR_OFFICE=
# SRC_DIR_TXT=
# 模型根目录（默认取包内 RAG_PROJECT/models）
# MODELS_DIR=D:\path\to\models
# LangGraph 会话记忆持久化文件（默认在工作区根 checkpoints.db）
# CHECKPOINT_DB=D:\path\to\checkpoints.db

# ---- LLM 服务商（换服务商/换模型只改这里，不用动代码）----
# 例：DeepSeek 官方（注意其当前模型名为 deepseek-flash / deepseek-v4-pro，无 deepseek-chat）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0
# 结构化输出方式：DeepSeek 需用 function_calling（其 API 不支持 json_schema）
LLM_STRUCTURED_METHOD=function_calling
# 关闭 DeepSeek thinking（与 tool_choice 冲突）
LLM_DISABLE_THINKING=1

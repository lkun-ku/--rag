# ---- 虚拟环境（位于工作区根目录）----
.venv/
venv/
env/

# ---- 密钥：绝不入库 ----
.env
# .env 的备份/派生文件（如 .env.bak）同样含密钥，一并排除；
# 但模板文件 .env.example 必须入库，用 ! 例外。
.env.*
!.env.example

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 打包产物 ----
build/
dist/
*.egg-info/
.eggs/

# ---- LangGraph 会话记忆持久化文件（SqliteSaver 运行时生成）----
checkpoints.db
checkpoints.db-wal
checkpoints.db-shm

# ---- 本地模型（体积大，不进版本控制）----
# 嵌入模型跟随项目放在 models/ 下，但**不入库**：
# bge-large-zh-v1.5 约 1.3 GB，提交进 git 会让仓库无法使用。
# 需要时用 scripts/fetch_models.py 重建（见 ROADMAP 1.1.1）。
models/

# ---- 安装/探测/下载过程日志（临时产物）----
install*.log
install*.err
mlite_install*.log
mlite_install*.err
bge_*.log
bge_*.err
fmt_*.log
fmt_*.err
fmt_pid.txt
ingest*.log
ingest*.err
wm*.log
wm*.err
eval*.log
eval*.err
scan*.log
scan*.err
ca.log
cb.log
c*.err

# ---- 评测运行产物 ----
# eval/ 下需要**入库**的资产：
#   chunk_index.json    块清单（Golden Dataset 的 source_blocks 依据）
#   golden_dataset.jsonl 评测集（45 条，人工维护）
#   baseline.json       最新基线（ROADMAP 1.6 要求记录初始分数）
#   history.jsonl       历史趋势（用于区分「抖动」与「持续回退」）
# 只有缓存属于运行态产物（换模型/换语料即失效，体积随时间增长），排除。
eval/cache.jsonl
lite.log
lite.err
local_milvus.db/
*.db.lock

# ---- Milvus Lite 本地库（嵌入式，运行时生成；它其实是目录不是文件）----
*_test_lite*/
milvus.db/

# ---- 工具 / 编辑器本地状态 ----
# 说明：.idea/ 下保留了 misc.xml、modules.xml、*.iml、inspectionProfiles/
# 这类可共享的项目配置（仅含本机绝对路径的 workspace.xml 已删除），
# 但按 PyCharm 默认约定整体不入库。
.idea/
.vscode/
*.swp
.codebuddy/
